<?xml version="1.0" encoding="utf-8"?>
<!-- Hidden files have no MediaStore Uri; sharing them goes through this provider. Encrypted
     Hidden items are shared as decrypted copies in Lumen's private cache (vault-share). -->
<paths>
    <external-path name="storage" path="." />
    <cache-path name="vault_share" path="vault-share/" />
    <!-- Files Lumen makes to share, like exported subtitles. -->
    <cache-path name="exports" path="exports/" />
</paths>
