    <string name="main_encrypt_hidden_title">Encrypt Hidden?</string>
    <plurals name="main_encrypt_hidden_message_count">
        <item quantity="one">%1$d hidden items move into an encrypted vault that no other app or file manager can read (excluded folders stay as they are). It stays on your storage, so it survives uninstalling Lumen; your Lumen lock opens it again.\n\nIf you uninstall Lumen and forget your lock, these files can\'t be recovered by anyone. A password is safer than a short PIN.</item>
        <item quantity="other">%1$d hidden items move into an encrypted vault that no other app or file manager can read (excluded folders stay as they are). It stays on your storage, so it survives uninstalling Lumen; your Lumen lock opens it again.\n\nIf you uninstall Lumen and forget your lock, these files can\'t be recovered by anyone. A password is safer than a short PIN.</item>
    </plurals>
    <string name="main_encrypt_hidden_message_all">Everything in Hidden moves into an encrypted vault that no other app or file manager can read (excluded folders stay as they are). It stays on your storage, so it survives uninstalling Lumen; your Lumen lock opens it again.\n\nIf you uninstall Lumen and forget your lock, these files can\'t be recovered by anyone. A password is safer than a short PIN.</string>
    <string name="main_encrypt">Encrypt</string>
