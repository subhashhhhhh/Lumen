    <!-- Smart Search -->
    <string name="smart_search_title">Smart Search</string>
    <string name="smart_search_footer">Find photos by what\'s in them, like “cat asleep on a sofa”. Accurate finds more and understands many languages; Fast is smaller and quicker to set up, in English.</string>
    <string name="smart_search_quality">Search Quality</string>
    <string name="smart_search_model">Search Model</string>
    <string name="smart_search_remove_title">Remove Smart Search?</string>
    <string name="smart_search_remove_message">Searching by what\'s in photos stops working until you download it again. Text, faces and subtitles stay</string>
    <string name="smart_indexed">Indexed</string>
    <string name="smart_indexed_complete">New photos and videos are added as they arrive</string>

    <!-- Text in Photos -->
    <string name="smart_text_title">Text in Photos</string>
    <string name="smart_text_footer">Search the words in photos, screenshots and videos, like a name in a chat. Reads Latin scripts, Chinese and Japanese.</string>
    <string name="smart_text_model">Text Reader</string>
    <string name="smart_text_remove_title">Remove Text Reading?</string>
    <string name="smart_text_remove_message">Searching the words in photos stops working, and the words read so far are deleted</string>
    <string name="smart_text_read">Text Read</string>
    <string name="smart_text_read_complete">Words in photos and videos are searchable</string>

    <!-- Faces -->
    <string name="smart_faces_title">Faces</string>
    <string name="smart_faces_footer">Groups photos and videos by person, in Collections → People. Name people to find them in Search.</string>
    <string name="smart_faces_model">Face Models</string>
    <string name="smart_faces_remove_title">Remove Faces?</string>
    <string name="smart_faces_remove_message">People, their names and merges are deleted; downloading again finds everyone from scratch</string>
    <plurals name="smart_faces_people_found">
        <item quantity="one">%1$,d people found</item>
        <item quantity="other">%1$,d people found</item>
    </plurals>
    <plurals name="smart_faces_people_so_far">
        <item quantity="one">%1$s · %2$,d people so far</item>
        <item quantity="other">%1$s · %2$,d people so far</item>
    </plurals>

    <!-- Subtitles -->
    <string name="smart_subtitles_title">Subtitles</string>
    <string name="smart_subtitles_footer">Tap CC on a video to make subtitles on this phone. Works for English, German, French, Spanish, Italian, Dutch and Polish speech; music without speech gets none.</string>
    <string name="smart_subtitles_quality">Subtitle Quality</string>
    <string name="smart_subtitles_model">Subtitles Model</string>
    <string name="smart_subtitles_remove_title">Remove Subtitles?</string>
    <string name="smart_subtitles_remove_message">CC can\'t make new subtitles until you download it again. Subtitles already made stay</string>

    <!-- Scheduled Indexing -->
    <string name="smart_schedule_title">Scheduled Indexing</string>
    <string name="smart_schedule_footer_on">Photos and videos are indexed only in these hours, plugged in or not (it stops if the battery runs low or the phone gets warm). New photos are still added as they arrive. Unplugged, Android lets background work run only now and then at night, so it\'s fastest on the charger.</string>
    <string name="smart_schedule_footer_off">Index the backlog at a time you choose, like overnight, instead of whenever the phone charges.</string>
    <string name="smart_schedule_starts">Starts</string>
    <string name="smart_schedule_ends">Ends</string>

    <!-- Indexing and Downloads -->
    <string name="smart_downloads_title">Indexing and Downloads</string>
    <string name="smart_downloads_footer">Models download once from Hugging Face; your photos and searches never leave this phone.</string>
    <string name="smart_index_on_battery">Index on Battery</string>
    <string name="smart_index_on_battery_subtitle">Keep scanning off the charger; stops when the battery runs low</string>
    <string name="smart_video_detail">Video Detail</string>
    <string name="smart_video_detail_subtitle">Frame size for faces and text in videos; lower is faster on older phones</string>
    <string name="smart_wifi_only">Download on Wi-Fi Only</string>
    <string name="smart_hf_token">Hugging Face Token</string>
    <string name="smart_hf_token_subtitle">Optional; can make downloads faster</string>
    <string name="smart_hf_token_saved">Saved</string>
    <string name="smart_hf_token_none">None</string>
    <string name="smart_hf_token_remove_title">Remove Your Token?</string>
    <string name="smart_hf_token_remove_message">Downloads will go without it. It\'s stored encrypted on this phone only.</string>

    <!-- Licenses screen -->
    <string name="licenses_title">Licenses</string>
    <string name="licenses_intro">Lumen is free and open source under the Apache License 2.0. It\'s built on the work of these open-source projects. Tap one to visit it.</string>
    <string name="licenses_credits">Credits</string>

    <!-- What each credited project is used for -->
    <string name="licenses_used_backdrop">The liquid glass you see everywhere in Lumen</string>
    <string name="licenses_used_liquid_glass_easy">The motion of the glass selection pill in the tab bar</string>
    <string name="licenses_used_telephoto">Zooming and tiled loading of large photos</string>
    <string name="licenses_used_coil">Image loading</string>
    <string name="licenses_used_avif">AVIF photos, on phones whose own decoder can\'t show them</string>
    <string name="licenses_used_androidx">UI, video playback, EXIF and the rest of the platform pieces</string>
    <string name="licenses_used_kotlin">The language and its async library</string>
    <string name="licenses_used_icons">Icons</string>
    <string name="licenses_used_geonames">Offline place names for photo locations</string>
    <string name="licenses_used_siglip">Smart Search, Accurate: the model that understands what\'s in photos</string>
    <string name="licenses_used_openclip">Smart Search, Fast</string>
    <string name="licenses_used_immich">The ONNX exports Lumen\'s search models are converted from; no Immich code is used</string>
    <string name="licenses_used_ocr">Reading text in photos and videos</string>
    <string name="licenses_used_yunet">Finding faces</string>
    <string name="licenses_used_sface">Telling faces apart, to group them into people</string>
    <string name="licenses_used_whistle">Subtitles: speech to text on the phone</string>
    <string name="licenses_used_silero">Subtitles: finding where people speak</string>
    <string name="licenses_used_onnx_runtime">Runs most of Lumen\'s models on the phone</string>
    <string name="licenses_used_litert">Runs models on the phone\'s GPU</string>
    <string name="licenses_used_ram">The words for \"Looks like\" and search suggestions</string>
    <string name="licenses_used_maplibre">Draws the maps in photo details</string>
    <string name="licenses_used_openfreemap">The map tiles and styles</string>
    <string name="licenses_used_openmaptiles">The map tiles\' schema and style design</string>
    <string name="licenses_used_osm">The map data</string>
